@model Pedido
@{
    bool esAdmin = User.IsInRole("Administrador");
    ViewData["Title"] = $"Pedido #{Model.PedidoId}";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a class="text-decoration-none" asp-action="Index">Listado</a></li>
        <li class="breadcrumb-item active" aria-current="page">Detalle</li>
    </ol>
</nav>

<h2 class="text-center mb-3">@ViewData["Title"] <span class="badge text-bg-secondary fs-6">@Model.Estado</span></h2>

<div class="card mt-3">
    <div class="card-body small">
        <div class="mb-2"><span class="text-muted">Fecha:</span> @Model.Fecha.ToLocalTime().ToString("g")</div>
        <div class="mb-2"><span class="text-muted">Usuario:</span> @Model.Usuario</div>
        <div class="mb-3" style="white-space: pre-line;"><span class="text-muted">Dirección de envío:</span> @Model.DireccionEnvio</div>
        <div class="table-responsive">
            <table class="table table-sm table-bordered align-middle">
                <thead class="text-center">
                    <tr><th>Producto</th><th>Precio unitario</th><th>Cantidad</th><th>Subtotal</th></tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.Titulo</td>
                            <td class="text-end">@item.PrecioUnitario.ToString("C")</td>
                            <td class="text-center">@item.Cantidad</td>
                            <td class="text-end">@item.Subtotal.ToString("C")</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr><th colspan="3" class="text-end">Total</th><th class="text-end">@Model.Total.ToString("C")</th></tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

@if (!esAdmin && Model.Estado != EstadoPedido.Pendiente && Model.Estado != EstadoPedido.Cancelado)
{
    <p class="text-center text-muted small mt-3">
        Este pedido ya está en estado «@Model.Estado». Solo se pueden cancelar los pedidos pendientes.
    </p>
}

<div class="text-center mt-3 d-flex justify-content-center gap-2 flex-wrap">
    <a class="btn btn-sm btn-outline-secondary" asp-action="Index">Regresar</a>
    @if (!esAdmin && Model.Estado == EstadoPedido.Pendiente)
    {
        <form asp-action="Cancelar" asp-route-id="@Model.PedidoId" method="post">
            <button type="submit" class="btn btn-sm btn-outline-danger">Cancelar pedido</button>
        </form>
    }
    @if (esAdmin)
    {
        @foreach (var siguiente in EstadoPedido.Siguientes(Model.Estado))
        {
            <form asp-action="Estado" asp-route-id="@Model.PedidoId" method="post">
                <input type="hidden" name="estado" value="@siguiente" />
                <button type="submit" class="btn btn-sm @(siguiente == EstadoPedido.Cancelado ? "btn-outline-danger" : "btn-primary")">Marcar como @siguiente</button>
            </form>
        }
    }
</div>
