@{
    int codigo = ViewBag.Codigo ?? 500;
    ViewData["Title"] = codigo switch
    {
        404 => "Page not found",
        403 => "Access denied",
        401 => "Sign-in required",
        _ => "A problem occurred"
    };
}

<div class="container">
    <h1 class="text-danger">@codigo <small class="fs-4">@ViewData["Title"]</small></h1>
    <p class="text-muted">
        @(codigo == 404
            ? "The requested resource does not exist or is no longer available."
            : "The request could not be processed.")
    </p>
    <p><a class="btn btn-sm btn-outline-secondary" asp-controller="Home" asp-action="Index">Go to Home</a></p>
</div>
