@{
    int statusCode = ViewBag.StatusCode ?? 500;
    ViewData["Title"] = statusCode switch
    {
        404 => "Página no encontrada",
        403 => "Acceso denegado",
        401 => "Inicio de sesión requerido",
        _ => "Ocurrió un problema"
    };
}

<div class="container">
    <h1 class="text-danger">@statusCode <small class="fs-4">@ViewData["Title"]</small></h1>
    <p class="text-muted">
        @(statusCode == 404
            ? "El elemento que busca no existe o ya no está disponible."
            : "No fue posible atender la solicitud.")
    </p>
    <p><a class="btn btn-sm btn-outline-secondary" asp-controller="Home" asp-action="Index">Ir al inicio</a></p>
</div>
