@model List<Product>
@{
    bool canManage = ViewBag.CanManage == true;
    ViewData["Title"] = canManage ? "Mis productos" : "Productos";
    ViewData["SubTitle"] = "Listado";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item active" aria-current="page">@ViewData["SubTitle"]</li>
    </ol>
</nav>

<h2 class="text-center mb-3">@ViewData["Title"] <small class="text-muted fs-5">@ViewData["SubTitle"]</small></h2>

@if (!canManage)
{
    <div class="alert alert-info small py-2" role="status">
        <i class="bi bi-info-circle"></i> Vista de solo lectura. Los administradores no publican productos; para publicar o editar artículos se requiere una cuenta de vendedor aprobada.
    </div>
}

<div class="row small">
    <div class="col-12 col-sm-6 col-md-4 col-lg-3">
        <form asp-action="Index" method="get">
            <div class="input-group input-group-sm mb-3">
                <input name="s" id="s" value="@ViewBag.Search" type="search" maxlength="255" class="form-control"
                       placeholder="Buscar por título">
                <button class="btn btn-primary" type="submit" title="Buscar"><i class="bi bi-search"></i></button>
            </div>
        </form>
    </div>
</div>

<div class="row small mb-3">
    <div class="col">
        @if (canManage)
        {
            <a class="text-decoration-none" asp-action="Create" title="Crear nuevo">Crear nuevo</a>
        }
    </div>
    <div class="col text-end">
        Mostrando @Model.Count de @ViewBag.Total productos
    </div>
</div>

@if (Model.Count > 0)
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered small align-middle">
            <thead class="text-center">
                <tr>
                    <th width="1">@Html.DisplayNameFor(model => model.First().ProductId)</th>
                    <th width="1">@Html.DisplayNameFor(model => model.First().ImageUrl)</th>
                    <th>@Html.DisplayNameFor(model => model.First().Title)</th>
                    <th>@Html.DisplayNameFor(model => model.First().Stock)</th>
                    <th>@Html.DisplayNameFor(model => model.First().Price)</th>
                    <th></th>
                    @if (canManage)
                    {
                        <th></th>
                        <th></th>
                        <th></th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var imageSrc = string.IsNullOrWhiteSpace(item.ImageUrl)
                        ? "https://placehold.co/60x60/FFF/999?text=Art%C3%ADculo"
                        : item.ImageUrl;
                    <tr>
                        <td>@item.ProductId</td>
                        <td class="text-center" width="1">
                            <img src="@imageSrc" alt="@item.Title" class="img-fluid img-thumbnail" style="max-height: 40px;">
                        </td>
                        <td>
                            @item.Title
                            @if (canManage)
                            {
                                @if (item.HasEffectiveImage)
                                {
                                    <span class="badge text-bg-success ms-1">Publicado</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-warning text-dark ms-1">Borrador (sin imagen)</span>
                                }
                            }
                            <br />
                            @if (!string.IsNullOrWhiteSpace(item.Description))
                            {
                                <span class="text-secondary-emphasis small d-none d-md-block">@item.Description</span>
                            }
                            @foreach (var cat in item.Categories ?? [])
                            {
                                <span class="badge rounded-pill text-bg-secondary">@cat.Name</span>
                            }
                        </td>
                        <td class="text-center">@item.Stock</td>
                        <td class="text-end">@DisplayFormatter.FormatCurrency(item.Price)</td>
                        <td width="1">
                            <a class="text-decoration-none small text-uppercase" asp-action="Details" asp-route-id="@item.ProductId">Detalles</a>
                        </td>
                        @if (canManage)
                        {
                            <td width="1">
                                <a class="text-decoration-none small text-uppercase" asp-action="Categories" asp-route-id="@item.ProductId">Categorías</a>
                            </td>
                            <td width="1">
                                <a class="text-decoration-none small text-uppercase" asp-action="Edit" asp-route-id="@item.ProductId">Editar</a>
                            </td>
                            <td width="1">
                                <a class="text-decoration-none small text-uppercase" asp-action="Delete" asp-route-id="@item.ProductId">Eliminar</a>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_PaginationPartial" />
}
else
{
    <div class="mt-5">
        <div class="alert alert-warning" role="alert">
            No se encontraron productos.
        </div>
    </div>
}
