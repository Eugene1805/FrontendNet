@model Product
@{
    var imageSrc = string.IsNullOrWhiteSpace(Model.ImageUrl)
        ? "https://placehold.co/300x450/FFF/999?text=Art%C3%ADculo"
        : Model.ImageUrl;
}

<div class="card mt-3">
    <div class="row g-0">
        <div class="col-md-4 text-center bg-white pt-3">
            <img src="@imageSrc" alt="@Model.Title" class="product-cover img-fluid" style="max-height: 300px;">
        </div>
        <div class="col-md-8">
            <div class="card-body">
                <div class="mb-3 ps-3">
                    <label asp-for="ProductId" class="form-label form-text"></label>
                    <div class="form-text text-body">@Model.ProductId</div>
                </div>
                <div class="mb-3 ps-3">
                    <label asp-for="Title" class="form-label form-text"></label>
                    <div class="form-text text-body">
                        @Model.Title
                        @if (Model.HasImage.HasValue)
                        {
                            @if (Model.HasEffectiveImage)
                            {
                                <span class="badge text-bg-success ms-1">Publicado</span>
                            }
                            else
                            {
                                <span class="badge text-bg-warning text-dark ms-1">Borrador (sin imagen)</span>
                            }
                        }
                    </div>
                </div>
                <div class="mb-3 ps-3">
                    <label asp-for="Price" class="form-label form-text"></label>
                    <div class="form-text text-body">@DisplayFormatter.FormatCurrency(Model.Price)</div>
                </div>
                <div class="mb-3 ps-3">
                    <label asp-for="Stock" class="form-label form-text"></label>
                    <div class="form-text text-body">@Model.Stock</div>
                </div>
                <div class="mb-3 ps-3">
                    <label asp-for="Description" class="form-label form-text"></label>
                    <div class="form-text text-body">@(string.IsNullOrWhiteSpace(Model.Description) ? "Sin descripción" : Model.Description)</div>
                </div>
            </div>
        </div>
    </div>
</div>
