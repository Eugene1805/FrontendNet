<div class="navbar-nav small">
    <div class="navbar-text form-check form-switch form-check-reverse me-2">
        <input class="form-check-input" type="checkbox" id="darkModeSwitch" aria-label="Cambiar tema">
        <label class="form-check-label" for="darkModeSwitch"><i class="bi bi-moon-stars theme-icon"></i></label>
    </div>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a class="nav-link" asp-controller="Profile" asp-action="Index">¡Hola @(User.Identity.Name)!</a>
        <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline my-auto">
            <button type="submit" class="btn btn-link nav-link p-0 text-decoration-none border-0 align-baseline" style="background:none;">Salir</button>
        </form>
    }
    else
    {
        <a class="nav-link" asp-controller="Auth" asp-action="Register">Crear cuenta</a>
        <a class="nav-link" asp-controller="Auth" asp-action="Index">Iniciar sesión</a>
    }
    <div class="navbar-text">
        <img src="~/images/netlogo.jpg" alt="Logotipo de la plataforma" height="30" />
    </div>
</div>
