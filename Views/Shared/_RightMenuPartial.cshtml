<div class="navbar-nav small">
    <div class="navbar-text form-check form-switch form-check-reverse me-2">
        <input class="form-check-input" type="checkbox" id="darkModeSwitch">
        <label class="form-check-label" for="darkModeSwitch"><i class="bi bi-moon-stars modo-luz"></i></label>
    </div>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a class="nav-link" asp-controller="Profile" asp-action="Index">Hello @(User.Identity.Name)!</a>
        <form asp-controller="Auth" asp-action="Salir" method="post" class="d-inline my-auto">
            <button type="submit" class="btn btn-link nav-link p-0 text-decoration-none border-0 align-baseline" style="background:none;">Sign out</button>
        </form>
    }
    else
    {
        <a class="nav-link" asp-controller="Auth" asp-action="Index">Sign in</a>
    }
    <div class="navbar-text">
        <img src="~/images/netlogo.jpg" alt="User Icon" height="30" />
    </div>
</div>
