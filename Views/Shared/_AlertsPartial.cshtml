@inject IConfiguration Configuration
@if (Configuration.GetValue<bool>("Features:CompraSimulada") && (User.IsInRole("Usuario") || User.IsInRole("BUYER")))
{
    <div class="alert alert-info small py-2" role="status">
        <i class="bi bi-info-circle"></i>
        <strong>Simulation mode:</strong> cart and orders are stored only in this web server
        (they are lost on restart) and payment is simulated. The backend does not yet offer these services.
    </div>
}
@if (TempData["Exito"] is string exito)
{
    <div class="alert alert-success small py-2" role="status">@exito</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger small py-2" role="alert">@error</div>
}
