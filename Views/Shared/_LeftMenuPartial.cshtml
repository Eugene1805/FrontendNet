@using System.Security.Claims
<div class="me-auto navbar-nav">
    @if (User.Identity?.IsAuthenticated == true)
    {
        @if (User.IsInRole("BUYER") || User.IsInRole("Usuario"))
        {
            <a class="nav-link" asp-controller="Shopping" asp-action="Index">Shop</a>
            <a class="nav-link" asp-controller="ShoppingCart" asp-action="Index"><i class="bi-cart"></i> Cart
                @await Component.InvokeAsync("CarritoResumen")</a>
            <a class="nav-link" asp-controller="Orders" asp-action="Index">My Orders</a>
        }
        else if (User.IsInRole("SELLER") || User.IsInRole("Vendedor"))
        {
            <a class="nav-link" asp-controller="Products" asp-action="Index">Products</a>
            <a class="nav-link" asp-controller="Orders" asp-action="Index">Orders</a>
        }
        else if (User.IsInRole("ADMIN") || User.IsInRole("Administrador"))
        {
            <a class="nav-link" asp-controller="Categories" asp-action="Index">Categories</a>
            <a class="nav-link" asp-controller="Users" asp-action="Index">Users</a>
            <a class="nav-link" asp-controller="Orders" asp-action="Index">Orders</a>
            <a class="nav-link" asp-controller="AuditLog" asp-action="Index">Audit Log</a>
        }
    }
    else
    {
        <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
    }
</div>
