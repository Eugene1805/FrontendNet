@inject IConfiguration Configuration
@if (Configuration.GetValue<bool>("Features:CompraSimulada") && User.IsInRole("Usuario"))
{
    <div class="alert alert-info small py-2" role="status">
        <i class="bi bi-info-circle"></i>
        <strong>Modo simulación:</strong> el carrito y los pedidos se guardan solo en este servidor web
        (se pierden al reiniciarlo) y el pago es simulado. El backend todavía no ofrece estos servicios.
    </div>
}
@if (TempData["Exito"] is string exito)
{
    <div class="alert alert-success small py-2" role="status">@exito</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger small py-2" role="alert">@error</div>
}
