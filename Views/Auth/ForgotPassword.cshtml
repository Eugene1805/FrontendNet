@model ForgotPasswordModel
@{
    ViewData["Title"] = "Recuperar contraseña";
}

<form asp-action="ForgotPassword" method="post">
    <div class="card mx-auto" style="max-width: 500px;">
        <div class="card-body">
            <h1 class="h3 text-center">@ViewData["Title"]</h1>
            <p class="text-center text-muted small">Ingresa tu correo electrónico y te enviaremos un código de 6 dígitos para restablecer tu contraseña.</p>
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-floating mb-3">
                <input asp-for="Email" maxlength="254" class="form-control" placeholder="Correo electrónico" autocomplete="email" />
                <label asp-for="Email" class="form-label"></label>
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-between small">
                <a asp-action="ResetPassword" class="link-primary text-decoration-none">Ya tengo un código</a>
                <a asp-action="Index" class="link-primary text-decoration-none">Iniciar sesión</a>
            </div>
        </div>
        <div class="card-footer text-center">
            <button id="submitButton" type="submit" class="btn btn-primary">Enviar código</button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
