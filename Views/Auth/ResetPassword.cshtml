@model ResetPasswordModel
@{
    ViewData["Title"] = "Restablecer contraseña";
}

<form asp-action="ResetPassword" method="post" autocomplete="off">
    <div class="card mx-auto" style="max-width: 500px;">
        <div class="card-body">
            <h1 class="h3 text-center">@ViewData["Title"]</h1>
            <p class="text-center text-muted small">Ingresa el código de 6 dígitos recibido en tu correo y define una nueva contraseña segura.</p>
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-floating mb-3">
                <input asp-for="Email" class="form-control" placeholder="Correo electrónico" autocomplete="email" />
                <label asp-for="Email" class="form-label"></label>
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Code" class="form-control" placeholder="000000" maxlength="6" inputmode="numeric" autocomplete="one-time-code" />
                <label asp-for="Code" class="form-label"></label>
                <span asp-validation-for="Code" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="NewPassword" class="form-control" placeholder="Nueva contraseña" autocomplete="new-password" />
                <label asp-for="NewPassword" class="form-label"></label>
                <span asp-validation-for="NewPassword" class="text-danger"></span>
                <div class="form-text small">De 8 a 128 caracteres con al menos una letra, un número y un carácter especial.</div>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="ConfirmPassword" class="form-control" placeholder="Confirmar nueva contraseña" autocomplete="new-password" />
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-between small">
                <a asp-action="ForgotPassword" class="link-primary text-decoration-none">Solicitar otro código</a>
                <a asp-action="Index" class="link-primary text-decoration-none">Iniciar sesión</a>
            </div>
        </div>
        <div class="card-footer text-center">
            <button id="submitButton" type="submit" class="btn btn-primary">Guardar nueva contraseña</button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
