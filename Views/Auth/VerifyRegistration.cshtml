@model VerifyRegistrationModel
@{
    ViewData["Title"] = "Verificar cuenta";
}

<form asp-action="VerifyRegistration" method="post">
    <div class="card mx-auto" style="max-width: 500px;">
        <div class="card-body">
            <h1 class="h3 text-center">@ViewData["Title"]</h1>
            <p class="text-center text-muted small">Ingresa el correo registrado y el código de 6 dígitos que enviamos a tu bandeja.</p>
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-floating mb-3">
                <input asp-for="Email" maxlength="254" class="form-control" placeholder="Correo electrónico" autocomplete="email" />
                <label asp-for="Email" class="form-label"></label>
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Code" class="form-control" placeholder="000000" minlength="6" maxlength="6" pattern="\d{6}" inputmode="numeric" autocomplete="one-time-code" />
                <label asp-for="Code" class="form-label"></label>
                <span asp-validation-for="Code" class="text-danger"></span>
                <div class="form-text small">El código vence en 10 minutos (máximo 5 intentos). Si necesitas otro código, espera 60 segundos y vuelve a enviar el registro.</div>
            </div>

            <div class="d-flex justify-content-between small">
                <a asp-action="Register" class="link-primary text-decoration-none">Volver al registro</a>
                <a asp-action="Index" class="link-primary text-decoration-none">Iniciar sesión</a>
            </div>
        </div>
        <div class="card-footer text-center">
            <button id="submitButton" type="submit" class="btn btn-primary">Verificar cuenta</button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
