@model List<AuditEntry>
@{
    ViewData["Title"] = "Bitácora";
    ViewData["SubTitle"] = "Listado";
    int limit = ViewBag.Limit ?? 50;
    int? currentBefore = ViewBag.CurrentBefore as int?;
    int? nextBefore = ViewBag.NextBefore as int?;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item active" aria-current="page">@ViewData["SubTitle"]</li>
    </ol>
</nav>

<h2 class="text-center mb-3">@ViewData["Title"] <small class="text-muted fs-5">@ViewData["SubTitle"]</small></h2>

<div class="row small mb-3 align-items-center">
    <div class="col">
        <form asp-action="Index" method="get" class="d-inline-flex align-items-center gap-2">
            <label for="limit" class="form-label mb-0">Registros por página:</label>
            <select id="limit" name="limit" class="form-select form-select-sm" style="width: auto;">
                <option value="20" selected="@(limit == 20)">20</option>
                <option value="50" selected="@(limit == 50)">50</option>
                <option value="100" selected="@(limit == 100)">100</option>
            </select>
            <button type="submit" class="btn btn-sm btn-outline-primary">Aplicar</button>
        </form>
    </div>
    <div class="col text-end">
        Mostrando @Model.Count elementos
    </div>
</div>

@if (Model.Count > 0)
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered small align-middle">
            <thead class="text-center">
                <tr>
                    <th>@Html.DisplayNameFor(model => model.First().Id)</th>
                    <th>@Html.DisplayNameFor(model => model.First().Action)</th>
                    <th>@Html.DisplayNameFor(model => model.First().TargetType)</th>
                    <th>@Html.DisplayNameFor(model => model.First().TargetId)</th>
                    <th>@Html.DisplayNameFor(model => model.First().ActorUserId)</th>
                    <th>@Html.DisplayNameFor(model => model.First().IpAddress)</th>
                    <th>@Html.DisplayNameFor(model => model.First().Outcome)</th>
                    <th>@Html.DisplayNameFor(model => model.First().OccurredAt)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Action</td>
                        <td>@(item.TargetType ?? "—")</td>
                        <td class="text-break">@(item.TargetId ?? "—")</td>
                        <td class="text-break">@(item.ActorUserId ?? "—")</td>
                        <td>@(item.IpAddress ?? "—")</td>
                        <td class="text-center">
                            <span class="badge @DisplayFormatter.AuditOutcomeBadgeClass(item.Outcome)">@DisplayFormatter.AuditOutcomeLabel(item.Outcome)</span>
                        </td>
                        <td>@DisplayFormatter.FormatLocalDateTime(item.OccurredAt)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="d-flex justify-content-center gap-2 mt-3">
        @if (currentBefore is > 0)
        {
            <a class="btn btn-sm btn-outline-secondary" asp-action="Index" asp-route-limit="@limit">Más recientes</a>
        }
        @if (nextBefore is > 0)
        {
            <a class="btn btn-sm btn-outline-primary" asp-action="Index" asp-route-limit="@limit" asp-route-before="@nextBefore">Anteriores</a>
        }
    </div>
}
else
{
    <div class="mt-5">
        <div class="alert alert-warning" role="alert">
            No se encontraron elementos. Por favor, intente más tarde.
        </div>
    </div>
}
