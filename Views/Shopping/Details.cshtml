@model Product
@{
    ViewData["Title"] = Model.Title;
    var imageSrc = string.IsNullOrWhiteSpace(Model.ImageUrl)
        ? "https://placehold.co/300x300/FFF/999?text=Art%C3%ADculo"
        : Model.ImageUrl;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a class="text-decoration-none" asp-action="Index">Tienda</a></li>
        <li class="breadcrumb-item active" aria-current="page">Detalles</li>
    </ol>
</nav>

<div class="card">
    <div class="row g-0">
        <div class="col-md-4 text-center p-3 bg-white">
            <img src="@imageSrc" alt="@Model.Title" class="img-fluid" style="max-height: 320px;">
        </div>
        <div class="col-md-8">
            <div class="card-body">
                <h3 class="card-title">@Model.Title</h3>
                <h4 class="text-success">@DisplayFormatter.FormatCurrency(Model.Price)</h4>
                <p class="small @(Model.Stock > 0 ? "text-success" : "text-danger") fw-semibold">
                    @(Model.Stock > 0 ? $"Disponible ({Model.Stock} unidades)" : "Agotado")
                </p>
                <p class="card-text">
                    @foreach (var cat in Model.Categories ?? [])
                    {
                        <span class="badge rounded-pill text-bg-warning">@cat.Name</span>
                    }
                </p>
                <p class="card-text" style="white-space: pre-line;">@(string.IsNullOrWhiteSpace(Model.Description) ? "Sin descripción" : Model.Description)</p>
                <form asp-controller="ShoppingCart" asp-action="Add" method="post" class="row g-2 align-items-center">
                    <input type="hidden" name="productId" value="@Model.ProductId" />
                    <div class="col-auto">
                        <label for="quantity" class="col-form-label small">Cantidad</label>
                    </div>
                    <div class="col-auto">
                        <input type="number" id="quantity" name="quantity" value="1" min="1" max="@Math.Max(1, Model.Stock)"
                               class="form-control form-control-sm" style="width: 5rem;" />
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-primary btn-sm" disabled="@(Model.Stock <= 0)">
                            <i class="bi bi-cart-plus"></i> Agregar al carrito
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
