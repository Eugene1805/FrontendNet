@model FileRecord
@{
    ViewData["Title"] = "Files";
    ViewData["SubTitle"] = "Delete";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a class="text-decoration-none" title="Back to list"
                asp-action="Index">List</a></li>
        <li class="breadcrumb-item active" aria-current="page">@ViewData["SubTitle"]</li>
    </ol>
</nav>

<h2 class="text-center mb-3">@ViewData["Title"] <small class="text-muted fs-5">@ViewData["SubTitle"]</small></h2>

<p class="text-danger">¿Está seguro que desea eliminar este elemento?</p>
<p class="text-danger">@ViewData["ErrorMessage"]</p>

<partial name="_DetailsPartial" />
<form asp-action="Eliminar">
    <div class="text-center mt-3">
        <button id="btnEnviar" type="submit" class="btn btn-sm btn-primary">Delete</button>
        <a class="btn btn-sm btn-outline-secondary" asp-action="Index" title="Cancel">Cancel</a>
    </div>
</form>