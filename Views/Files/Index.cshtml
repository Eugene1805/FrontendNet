@model List<FileRecord>
@{
    ViewData["Title"] = "Files";
    ViewData["SubTitle"] = "Listado";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item active" aria-current="page">@ViewData["SubTitle"]</li>
    </ol>
</nav>

<h2 class="text-center mb-3">@ViewData["Title"] <small class="text-muted fs-5">@ViewData["SubTitle"]</small></h2>

<div class="row small mb-3">
    <div class="col">
        <a class="text-decoration-none" asp-action="Crear" title="Crear nuevo">Agregar nuevo</a>
    </div>
    <div class="col text-end">
        Showing @Model.Count() de @ViewBag.Total items
    </div>
</div>

@if (Model.Count() > 0)
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered small">
            <thead class="text-center">
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.First().FileId)
                    </th>
                    <th>Poster</th>
                    <th>
                        @Html.DisplayNameFor(model => model.First().Name)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.First().Mime)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.First().Size)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.First().StoredInDatabase)
                    </th>
                    <th></th>
                    <th></th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.FileId)
                        </td>
                        <td class="text-center" width="1">
                            <img src="@(ViewBag.Url)/api/files/@(item.FileId)" alt="@item.Name" class="img-fluid img-thumbnail" style="max-height: 40px;">
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Name)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Mime)
                        </td>
                        <td>
                            @(item.Size / 1024) KB
                        </td>
                        <td>
                            @(item.StoredInDatabase ? "Database" : "Files")
                        </td>
                        <td width="1">
                            <a class="text-decoration-none small text-uppercase" asp-action="Detalle"
                               asp-route-id="@item.FileId">Details</a>
                        </td>
                        <td width="1">
                            <a class="text-decoration-none small text-uppercase" asp-action="Editar"
                               asp-route-id="@item.FileId">Edit</a>
                        </td>
                        <td width="1">
                            <a class="text-decoration-none small text-uppercase" asp-action="Eliminar"
                               asp-route-id="@item.FileId">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_PaginationPartial" />
}
else
{
    <div class="mt-5">
        <div class="alert alert-warning" role="alert">
            No items were found. Please try again later.
        </div>
    </div>
}