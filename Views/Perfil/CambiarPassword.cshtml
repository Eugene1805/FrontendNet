@model CambioPassword
@{
    ViewData["Title"] = "Perfil de usuario";
    ViewData["SubTitle"] = "Cambiar contraseña";
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a class="text-decoration-none" asp-action="Index">Perfil</a></li>
        <li class="breadcrumb-item active" aria-current="page">@ViewData["SubTitle"]</li>
    </ol>
</nav>

<h2 class="text-center mb-3">@ViewData["Title"] <small class="text-muted fs-5">@ViewData["SubTitle"]</small></h2>

<form asp-action="CambiarPassword" autocomplete="off">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="card mt-3">
        <div class="card-body small">
            <div class="form-floating mb-3">
                <input asp-for="PasswordActual" placeholder="Actual" class="form-control" autocomplete="current-password" />
                <label asp-for="PasswordActual" class="form-label"></label>
                <span asp-validation-for="PasswordActual" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="PasswordNueva" placeholder="Nueva" class="form-control" autocomplete="new-password" />
                <label asp-for="PasswordNueva" class="form-label"></label>
                <span asp-validation-for="PasswordNueva" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Confirmacion" placeholder="Confirmar" class="form-control" autocomplete="new-password" />
                <label asp-for="Confirmacion" class="form-label"></label>
                <span asp-validation-for="Confirmacion" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="text-center mt-3">
        <button id="btnEnviar" type="submit" class="btn btn-sm btn-primary">Guardar</button>
        <a class="btn btn-sm btn-outline-secondary" asp-action="Index">Cancelar</a>
    </div>
</form>
