@model Producto

<div class="card h-100">
    <div class="card-header text-center bg-white pt-3">
        <a asp-action="Detalle" asp-route-id="@Model.ProductoId">
            <img src="@(Model.ArchivoId == null ? "https://placehold.co/300x200/FFF/999?text=Articulo" : $"{ViewBag.Url}/api/archivos/{Model.ArchivoId}")"
                 alt="@Model.Titulo" class="img-fluid" data-url="@ViewBag.Url"
                 style="max-height: 200px; width: fit-content;">
        </a>
    </div>
    <div class="card-body d-flex flex-column">
        <p class="card-text">@Model.Titulo</p>
        <h5 class="card-title">@Html.DisplayFor(model => model.Precio)</h5>
        <p class="card-text">
            @foreach (var cat in Model.Categorias ?? [])
            {
                <span class="badge rounded-pill text-bg-warning">@cat.Nombre</span>
            }
        </p>
        <p class="mt-auto card-text text-success fw-semibold small"><i class="bi bi-lightning-fill"></i> Envío gratis
        </p>
    </div>
    <div class="card-footer d-flex gap-2">
        <a class="btn btn-outline-secondary btn-sm" asp-action="Detalle" asp-route-id="@Model.ProductoId">Ver</a>
        <form asp-controller="Carrito" asp-action="Agregar" method="post">
            <input type="hidden" name="productoid" value="@Model.ProductoId" />
            <input type="hidden" name="cantidad" value="1" />
            <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
            <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-cart-plus"></i> Agregar al carrito</button>
        </form>
    </div>
</div>
