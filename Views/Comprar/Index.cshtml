@model List<Producto>
@{
    ViewData["Title"] = "Comprar";
    ViewData["SubTitle"] = "Listado";
}
<h2 class="text-center mb-3">@ViewData["Title"] <small class="text-muted fs-5">@ViewData["SubTitle"]</small></h2>
<form asp-action="Index" method="get" class="row small g-2 mb-3">
    <div class="col-12 col-md-4">
        <div class="input-group input-group-sm">
            <input name="s" id="s" value="@ViewBag.search" type="search" class="form-control"
                   placeholder="Buscar por titulo">
            <button class="btn btn-primary" type="submit" title="Buscar"><i class="bi bi-search"></i></button>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <select name="categoriaid" class="form-select form-select-sm" asp-items="ViewBag.Categorias" aria-label="Categoría">
            <option value="">Todas las categorías</option>
        </select>
    </div>
    <div class="col-6 col-md-3">
        <select name="orden" class="form-select form-select-sm" asp-items="ViewBag.Ordenes" aria-label="Orden">
            <option value="">Orden predeterminado</option>
        </select>
    </div>
    <div class="col-12 col-md-2">
        <button class="btn btn-sm btn-outline-primary w-100" type="submit">Aplicar</button>
    </div>
</form>
<div class="row small mb-3">
    <div class="col text-end">
        Mostrando @Model.Count de @ViewBag.Total elementos
    </div>
</div>
@if (Model.Count > 0)
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <partial name="_CardPartial" model="item" />
            </div>
        }
    </div>
    <div class="mt-4"><partial name="_PaginacionPartial" /></div>
}
else
{
    <div class="mt-5">
        <div class="alert alert-warning" role="alert">
            No se han encontrado elementos. Inténtelo de nuevo más tarde.
        </div>
    </div>
}
