@model ShoppingCart
@section Scripts {
    <script src="~/js/cart.js" asp-append-version="true"></script>
}
@{
    ViewData["Title"] = "Carrito de compras";
    ViewData["SubTitle"] = "Listado";
}
<h2 class="text-center mb-3">@ViewData["Title"] <small class="text-muted fs-5">@ViewData["SubTitle"]</small></h2>

<div class="row small mb-3">
    <div class="col text-end">
        Mostrando @Model.Items.Count artículos (@Model.TotalItems piezas)
    </div>
</div>

@if (Model.Items.Count > 0)
{
    var hasUnavailable = Model.Items.Any(i => !i.Available);
    if (hasUnavailable)
    {
        <div class="alert alert-warning small py-2" role="alert">
            Algunos productos de tu carrito ya no tienen existencias suficientes o no están disponibles. Ajusta las cantidades o quítalos antes de continuar.
        </div>
    }
    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle small">
            <thead class="text-center">
                <tr>
                    <th>Producto</th>
                    <th>Precio</th>
                    <th>Cantidad</th>
                    <th>Subtotal</th>
                    <th width="1"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>
                            <a class="text-decoration-none" asp-controller="Shopping" asp-action="Details" asp-route-id="@item.ProductId">@(item.Title ?? $"Producto #{item.ProductId}")</a>
                            @if (!item.Available)
                            {
                                <span class="badge text-bg-danger ms-2">No disponible</span>
                            }
                        </td>
                        <td class="text-end">@DisplayFormatter.FormatCurrency(item.UnitPrice)</td>
                        <td>
                            <form asp-action="Update" method="post" data-autosubmit>
                                <input type="hidden" name="productId" value="@item.ProductId" />
                                <input type="number" name="quantity" value="@item.Quantity" min="1" max="999"
                                       class="form-control form-control-sm" style="width: 5.5rem;" aria-label="Cantidad" />
                                <noscript><button type="submit" class="btn btn-sm btn-outline-secondary mt-1">Actualizar</button></noscript>
                            </form>
                        </td>
                        <td class="text-end">@DisplayFormatter.FormatCurrency(item.Subtotal)</td>
                        <td>
                            <form asp-action="Remove" method="post">
                                <input type="hidden" name="productId" value="@item.ProductId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Quitar"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="3" class="text-end">Total</th>
                    <th class="text-end">@DisplayFormatter.FormatCurrency(Model.Subtotal)</th>
                    <th></th>
                </tr>
            </tfoot>
        </table>
    </div>
    <div class="d-flex justify-content-between">
        <form asp-action="Clear" method="post">
            <button type="submit" class="btn btn-sm btn-outline-secondary">Vaciar carrito</button>
        </form>
        @if (hasUnavailable)
        {
            <button type="button" class="btn btn-sm btn-primary" disabled>Continuar compra</button>
        }
        else
        {
            <a class="btn btn-sm btn-primary" asp-controller="Orders" asp-action="Checkout">Continuar compra</a>
        }
    </div>
}
else
{
    <div class="mt-5">
        <div class="alert alert-warning" role="alert">
            Su carrito está vacío. <a asp-controller="Shopping" asp-action="Index">Explore los productos</a>.
        </div>
    </div>
}
