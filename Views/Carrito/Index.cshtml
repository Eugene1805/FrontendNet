@model Carrito
@{
    ViewData["Title"] = "Carrito de compras";
    ViewData["SubTitle"] = "Listado";
}
<h2 class="text-center mb-3">@ViewData["Title"] <small class="text-muted fs-5">@ViewData["SubTitle"]</small></h2>

<div class="row small mb-3">
    <div class="col text-end">
        Mostrando @Model.Items.Count elementos (@Model.TotalArticulos artículos)
    </div>
</div>

@if (Model.Items.Count > 0)
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle small">
            <thead class="text-center">
                <tr>
                    <th width="1"></th>
                    <th>Producto</th>
                    <th>Precio</th>
                    <th>Cantidad</th>
                    <th>Subtotal</th>
                    <th width="1"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td class="text-center">
                            <img src="@(item.ArchivoId == null ? "https://placehold.co/27x40/FFF/999?text=%20" : $"{ViewBag.Url}/api/archivos/{item.ArchivoId}")"
                                 alt="@item.Titulo" class="img-fluid img-thumbnail" style="max-height: 40px;">
                        </td>
                        <td><a class="text-decoration-none" asp-controller="Comprar" asp-action="Detalle" asp-route-id="@item.ProductoId">@item.Titulo</a></td>
                        <td class="text-end">@item.Precio.ToString("C")</td>
                        <td>
                            <form asp-action="Actualizar" method="post" class="d-flex gap-1">
                                <input type="hidden" name="productoid" value="@item.ProductoId" />
                                <input type="number" name="cantidad" value="@item.Cantidad" min="1" max="99"
                                       class="form-control form-control-sm" style="width: 5rem;" aria-label="Cantidad" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary" title="Actualizar cantidad"><i class="bi bi-arrow-repeat"></i></button>
                            </form>
                        </td>
                        <td class="text-end">@item.Subtotal.ToString("C")</td>
                        <td>
                            <form asp-action="Quitar" method="post">
                                <input type="hidden" name="productoid" value="@item.ProductoId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Quitar"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="4" class="text-end">Total</th>
                    <th class="text-end">@Model.Total.ToString("C")</th>
                    <th></th>
                </tr>
            </tfoot>
        </table>
    </div>
    <div class="d-flex justify-content-between">
        <form asp-action="Vaciar" method="post">
            <button type="submit" class="btn btn-sm btn-outline-secondary">Vaciar carrito</button>
        </form>
        <a class="btn btn-sm btn-primary" asp-controller="Pedidos" asp-action="Checkout">Confirmar compra</a>
    </div>
}
else
{
    <div class="mt-5">
        <div class="alert alert-warning" role="alert">
            Su carrito está vacío. <a asp-controller="Comprar" asp-action="Index">Explore los productos</a>.
        </div>
    </div>
}
