@model UserEditModel
@{
    ViewData["Title"] = "Usuarios";
    ViewData["SubTitle"] = "Editar";
    bool canEdit = ViewBag.CanEdit == true;
    bool isSelf = ViewBag.IsSelf == true;
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a class="text-decoration-none" title="Volver al listado" asp-action="Index">Listado</a></li>
        <li class="breadcrumb-item active" aria-current="page">@ViewData["SubTitle"]</li>
    </ol>
</nav>

<h2 class="text-center mb-3">@ViewData["Title"] <small class="text-muted fs-5">@ViewData["SubTitle"]</small></h2>

@if (canEdit)
{
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Email" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="card mt-3">
            <div class="card-body small">
                <div class="form-floating mb-3">
                    <input asp-for="Id" placeholder="Id" readonly class="form-control-plaintext" />
                    <label asp-for="Id" class="form-label"></label>
                </div>
                <div class="form-floating mb-3">
                    <input value="@Model.Email" placeholder="Correo electrónico" readonly class="form-control-plaintext" />
                    <label asp-for="Email" class="form-label"></label>
                </div>
                <div class="form-floating mb-3">
                    <input value="@DisplayFormatter.ProfileLabel(Model.Profile)" placeholder="Perfil" readonly class="form-control-plaintext" />
                    <label asp-for="Profile" class="form-label"></label>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="Name" maxlength="120" placeholder="Nombre" class="form-control" />
                    <label asp-for="Name" class="form-label"></label>
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                @if (isSelf)
                {
                    <input type="hidden" asp-for="Status" />
                    <div class="form-floating mb-3">
                        <input value="@DisplayFormatter.UserStatusLabel(Model.Status)" readonly class="form-control-plaintext" />
                        <label asp-for="Status" class="form-label"></label>
                    </div>
                }
                else
                {
                    <div class="form-floating mb-3">
                        <select class="form-select" asp-for="Status" asp-items="ViewBag.UserStatuses"></select>
                        <label asp-for="Status" class="form-label"></label>
                        <span asp-validation-for="Status" class="text-danger"></span>
                    </div>
                }
                <div class="form-floating mb-3">
                    <input asp-for="Password" placeholder="Nueva contraseña" class="form-control" autocomplete="new-password" />
                    <label asp-for="Password" class="form-label"></label>
                    <span asp-validation-for="Password" class="text-danger"></span>
                    <div class="form-text small">Déjelo vacío para conservar la contraseña actual (8 a 128 caracteres con letra, número y símbolo).</div>
                </div>
            </div>
        </div>

        <div class="text-center mt-3">
            <button id="submitButton" type="submit" class="btn btn-sm btn-primary">Guardar</button>
            <a class="btn btn-sm btn-outline-secondary" asp-action="Index" title="Cancelar">Cancelar</a>
        </div>
    </form>
}
else
{
    <div class="mt-5">
        <div class="alert alert-warning" role="alert">
            La cuenta de administrador "<strong>@Model.Email</strong>" está protegida y no puede ser editada por otro administrador.
        </div>
    </div>

    <div class="text-center mt-3">
        <a class="btn btn-sm btn-outline-secondary" asp-action="Index" title="Cancelar">Cancelar</a>
    </div>
}
