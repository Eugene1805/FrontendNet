@model User

<div class="card mt-3">
    <div class="card-body">
        <div class="mb-3 ps-3">
            <label asp-for="Email" class="form-label form-text"></label>
            <div class="form-text text-body">@Model.Email</div>
        </div>
        <div class="mb-3 ps-3">
            <label asp-for="Name" class="form-label form-text"></label>
            <div class="form-text text-body">@Model.Name</div>
        </div>
        <div class="mb-3 ps-3">
            <label asp-for="Role" class="form-label form-text"></label>
            <div class="form-text text-body">@Model.Role</div>
        </div>
        @if (Model.Protected)
        {
            <div class="mb-3 ps-3">
                <span class="badge text-bg-secondary"><i class="bi bi-shield-lock"></i> User protegido</span>
            </div>
        }
    </div>
</div>