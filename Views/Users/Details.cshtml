@model User
@{
    ViewData["Title"] = "Usuarios";
    ViewData["SubTitle"] = "Detalles";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a class="text-decoration-none" title="Volver al listado" asp-action="Index">Listado</a></li>
        <li class="breadcrumb-item active" aria-current="page">@ViewData["SubTitle"]</li>
    </ol>
</nav>

<h2 class="text-center mb-3">@ViewData["Title"] <small class="text-muted fs-5">@ViewData["SubTitle"]</small></h2>

<partial name="_DetailsPartial" />

@if (string.Equals(Model.Profile, Roles.Seller, StringComparison.OrdinalIgnoreCase))
{
    <div class="card mt-3">
        <div class="card-body small">
            <h5 class="card-title fs-6">Gestión de vendedor</h5>
            @if (string.Equals(Model.SellerStatus, SellerStatuses.Pending, StringComparison.OrdinalIgnoreCase))
            {
                <div class="d-flex gap-3 flex-wrap align-items-center mt-2">
                    <form asp-action="ApproveSeller" method="post">
                        <input type="hidden" name="userId" value="@Model.Id" />
                        <input type="hidden" name="email" value="@Model.Email" />
                        <button type="submit" class="btn btn-sm btn-success">Aprobar vendedor</button>
                    </form>
                    <form asp-action="RejectSeller" method="post" class="d-flex gap-2 align-items-center flex-wrap">
                        <input type="hidden" name="userId" value="@Model.Id" />
                        <input type="hidden" name="email" value="@Model.Email" />
                        <input type="text" name="rejectionReason" minlength="1" maxlength="255" pattern=".*\S.*" required
                               title="Indique el motivo de rechazo (entre 1 y 255 caracteres)."
                               class="form-control form-control-sm"
                               style="min-width: 240px;" placeholder="Motivo de rechazo (máx. 255)" aria-label="Motivo de rechazo" />
                        <button type="submit" class="btn btn-sm btn-outline-danger">Rechazar vendedor</button>
                    </form>
                </div>
            }
            else if (string.Equals(Model.SellerStatus, SellerStatuses.Approved, StringComparison.OrdinalIgnoreCase))
            {
                <form asp-action="SuspendSeller" method="post" class="d-flex gap-2 align-items-center flex-wrap mt-2">
                    <input type="hidden" name="userId" value="@Model.Id" />
                    <input type="hidden" name="email" value="@Model.Email" />
                    <input type="text" name="reason" minlength="1" maxlength="255" pattern=".*\S.*" required
                           title="Indique el motivo de suspensión (entre 1 y 255 caracteres)."
                           class="form-control form-control-sm"
                           style="min-width: 260px;" placeholder="Motivo de suspensión (máx. 255)" aria-label="Motivo de suspensión" />
                    <button type="submit" class="btn btn-sm btn-outline-warning">Suspender vendedor</button>
                </form>
            }
            else
            {
                <p class="text-muted mb-0">No hay acciones de revisión disponibles para el estado actual.</p>
            }
        </div>
    </div>
}

<div class="text-center mt-3">
    <a class="btn btn-sm btn-outline-secondary" asp-action="Index" title="Volver">Volver</a>
</div>
