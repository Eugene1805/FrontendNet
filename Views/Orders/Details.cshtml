@model Order
@{
    bool isStaff = User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Seller);
    bool isBuyer = User.IsInRole(Roles.Buyer);
    ViewData["Title"] = $"Pedido #{Model.Id}";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a class="text-decoration-none" asp-action="Index">Listado</a></li>
        <li class="breadcrumb-item active" aria-current="page">Detalles</li>
    </ol>
</nav>

<h2 class="text-center mb-3">
    @ViewData["Title"]
    <span class="badge @DisplayFormatter.OrderStatusBadgeClass(Model.Status) fs-6">@DisplayFormatter.OrderStatusLabel(Model.Status)</span>
</h2>

<div class="card mt-3">
    <div class="card-body small">
        <div class="mb-2"><span class="text-muted">Fecha:</span> @DisplayFormatter.FormatLocalDateTime(Model.CreatedAt)</div>
        @if (isStaff)
        {
            <div class="mb-2"><span class="text-muted">Comprador:</span> @Model.BuyerId</div>
        }
        <div class="mb-2"><span class="text-muted">Vendedor:</span> @Model.SellerId</div>
        <div class="mb-3" style="white-space: pre-line;">
            <span class="text-muted">Dirección de envío:</span>
            @(Model.DeliveryAddressSnapshot?.FormatMultiline() ?? "No disponible")
        </div>
        <div class="table-responsive">
            <table class="table table-sm table-bordered align-middle">
                <thead class="text-center">
                    <tr>
                        <th>Producto</th>
                        <th>Precio unitario</th>
                        <th>Cantidad</th>
                        <th>Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.ProductTitle</td>
                            <td class="text-end">@DisplayFormatter.FormatCurrency(item.UnitPrice)</td>
                            <td class="text-center">@item.Quantity</td>
                            <td class="text-end">@DisplayFormatter.FormatCurrency(item.SubtotalValue)</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th colspan="3" class="text-end">Total</th>
                        <th class="text-end">@DisplayFormatter.FormatCurrency(Model.Total)</th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

@if (Model.History.Count > 0)
{
    <div class="card mt-3">
        <div class="card-body small">
            <h5 class="card-title fs-6">Historial de estados</h5>
            <div class="table-responsive">
                <table class="table table-sm table-striped align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Estado anterior</th>
                            <th>Nuevo estado</th>
                            <th>Motivo</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in Model.History)
                        {
                            <tr>
                                <td>@DisplayFormatter.FormatLocalDateTime(entry.OccurredAt)</td>
                                <td>@(string.IsNullOrWhiteSpace(entry.PreviousStatus) ? "—" : DisplayFormatter.OrderStatusLabel(entry.PreviousStatus))</td>
                                <td>@DisplayFormatter.OrderStatusLabel(entry.NewStatus)</td>
                                <td>@(string.IsNullOrWhiteSpace(entry.Reason) ? "—" : entry.Reason)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@if (isBuyer && !OrderStatus.CanBuyerCancel(Model.Status) && !string.Equals(Model.Status, OrderStatus.Canceled, StringComparison.OrdinalIgnoreCase))
{
    <p class="text-center text-muted small mt-3">
        Este pedido ya está en estado «@DisplayFormatter.OrderStatusLabel(Model.Status)». Solo se pueden cancelar pedidos pendientes.
    </p>
}

<div class="mt-3 d-flex flex-column align-items-center gap-3">
    @if (isBuyer && OrderStatus.CanBuyerCancel(Model.Status))
    {
        <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="d-flex gap-2 flex-wrap justify-content-center align-items-center">
            <input type="text" name="reason" minlength="1" maxlength="255" pattern=".*\S.*" required
                   title="Indique el motivo de cancelación (entre 1 y 255 caracteres)."
                   class="form-control form-control-sm" style="min-width: 260px;"
                   placeholder="Motivo de cancelación (máx. 255)" aria-label="Motivo de cancelación" />
            <button type="submit" class="btn btn-sm btn-outline-danger">Cancelar pedido</button>
        </form>
    }

    @if (isStaff)
    {
        <div class="d-flex justify-content-center gap-2 flex-wrap align-items-center">
            @foreach (var nextStatus in OrderStatus.GetNextStatusesForStaff(Model.Status))
            {
                if (nextStatus == OrderStatus.Canceled)
                {
                    <form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post" class="d-flex gap-2 align-items-center">
                        <input type="hidden" name="status" value="@nextStatus" />
                        <input type="text" name="reason" minlength="1" maxlength="255" pattern=".*\S.*" required
                               title="Indique el motivo de cancelación (entre 1 y 255 caracteres)."
                               class="form-control form-control-sm"
                               placeholder="Motivo de cancelación (máx. 255)" aria-label="Motivo de cancelación" />
                        <button type="submit" class="btn btn-sm btn-outline-danger">Marcar como @DisplayFormatter.OrderStatusLabel(nextStatus)</button>
                    </form>
                }
                else
                {
                    <form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post">
                        <input type="hidden" name="status" value="@nextStatus" />
                        <button type="submit" class="btn btn-sm btn-primary">Marcar como @DisplayFormatter.OrderStatusLabel(nextStatus)</button>
                    </form>
                }
            }
        </div>
    }

    <a class="btn btn-sm btn-outline-secondary" asp-action="Index">Regresar</a>
</div>
