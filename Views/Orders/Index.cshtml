@model List<OrderSummary>
@{
    bool isAdmin = User.IsInRole(Roles.Admin);
    bool isSeller = User.IsInRole(Roles.Seller);
    ViewData["Title"] = isAdmin || isSeller ? "Pedidos" : "Mis pedidos";
    ViewData["SubTitle"] = "Listado";
}
<h2 class="text-center mb-3">@ViewData["Title"] <small class="text-muted fs-5">@ViewData["SubTitle"]</small></h2>

<form asp-action="Index" method="get" class="row small g-2 mb-3">
    <div class="col-12 col-sm-6 col-md-4 col-lg-3">
        <div class="input-group input-group-sm">
            <select name="status" class="form-select" asp-items="ViewBag.Statuses" aria-label="Estado">
                <option value="">Todos los estados</option>
            </select>
            <button class="btn btn-primary" type="submit" title="Filtrar"><i class="bi bi-funnel"></i></button>
        </div>
    </div>
    <div class="col text-end align-self-center">Mostrando @Model.Count de @ViewBag.Total pedidos</div>
</form>

@if (Model.Count > 0)
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered small align-middle">
            <thead class="text-center">
                <tr>
                    <th>Pedido</th>
                    <th>Fecha</th>
                    @if (isAdmin)
                    {
                        <th>Comprador</th>
                        <th>Vendedor</th>
                    }
                    <th>Estado</th>
                    <th>Total</th>
                    <th width="1"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="text-center">#@item.Id</td>
                        <td>@DisplayFormatter.FormatLocalDateTime(item.CreatedAt)</td>
                        @if (isAdmin)
                        {
                            <td class="text-break">@item.BuyerId</td>
                            <td class="text-break">@item.SellerId</td>
                        }
                        <td class="text-center">
                            <span class="badge @DisplayFormatter.OrderStatusBadgeClass(item.Status)">@DisplayFormatter.OrderStatusLabel(item.Status)</span>
                        </td>
                        <td class="text-end">@DisplayFormatter.FormatCurrency(item.Total)</td>
                        <td>
                            <a class="text-decoration-none small text-uppercase" asp-action="Details" asp-route-id="@item.Id">Detalles</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_PaginationPartial" />
}
else
{
    <div class="mt-5">
        <div class="alert alert-warning" role="alert">
            No se han encontrado pedidos.
        </div>
    </div>
}
