@model NewOrder
@{
    ViewData["Title"] = "Confirm purchase";
    ShoppingCart carrito = ViewBag.ShoppingCart;
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a class="text-decoration-none" asp-controller="ShoppingCart" asp-action="Index">Cart</a></li>
        <li class="breadcrumb-item active" aria-current="page">Confirm</li>
    </ol>
</nav>

<h2 class="text-center mb-3">@ViewData["Title"]</h2>

<div class="card mt-3">
    <div class="card-body small">
        <h5 class="card-title">Order Summary</h5>
        <table class="table table-sm align-middle">
            <tbody>
                @foreach (var item in carrito.Items)
                {
                    <tr>
                        <td>@item.Title × @item.Quantity</td>
                        <td class="text-end">@item.Subtotal</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr><th>Total</th><th class="text-end">@carrito.Subtotal</th></tr>
            </tfoot>
        </table>
        <p class="text-muted mb-0">Prices are calculated on the server upon confirmation. Payment method: simulated.</p>
    </div>
</div>

<form asp-action="Checkout">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="card mt-3">
        <div class="card-body small">
            <div class="form-floating mb-3">
                <textarea asp-for="DireccionEnvio" placeholder="Shipping Address" class="form-control" style="height: 100px"></textarea>
                <label asp-for="DireccionEnvio" class="form-label"></label>
                <span asp-validation-for="DireccionEnvio" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="text-center mt-3">
        <button id="btnEnviar" type="submit" class="btn btn-sm btn-primary">Confirm order</button>
        <a class="btn btn-sm btn-outline-secondary" asp-controller="ShoppingCart" asp-action="Index">Cancel</a>
    </div>
</form>
