@model List<Address>
@{
    ViewData["Title"] = "Mis direcciones";
    ViewData["SubTitle"] = "Listado";
}

<h2 class="text-center mb-3">@ViewData["Title"] <small class="text-muted fs-5">@ViewData["SubTitle"]</small></h2>

<div class="row small mb-3">
    <div class="col">
        <a class="btn btn-sm btn-primary" asp-action="Create">Agregar dirección</a>
    </div>
    <div class="col text-end align-self-center">
        Mostrando @Model.Count direcciones
    </div>
</div>

@if (Model.Count > 0)
{
    <div class="row row-cols-1 row-cols-md-2 g-3">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 @(item.IsDefault ? "border-primary" : "")">
                    <div class="card-body small">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title mb-0">
                                @(string.IsNullOrWhiteSpace(item.Label) ? item.RecipientName : item.Label)
                            </h5>
                            @if (item.IsDefault)
                            {
                                <span class="badge text-bg-primary">Predeterminada</span>
                            }
                        </div>
                        <p class="mb-1 fw-semibold">@item.RecipientName</p>
                        <p class="mb-1">
                            @item.Street @item.ExteriorNumber
                            @if (!string.IsNullOrWhiteSpace(item.InteriorNumber))
                            {
                                <text> Int. @item.InteriorNumber</text>
                            }
                        </p>
                        <p class="mb-1">@item.Neighborhood</p>
                        <p class="mb-0 text-muted">@item.City, @item.State, C.P. @item.PostalCode, @item.Country</p>
                    </div>
                    <div class="card-footer d-flex gap-2 flex-wrap">
                        @if (!item.IsDefault)
                        {
                            <form asp-action="SetDefault" asp-route-id="@item.Id" method="post">
                                <button type="submit" class="btn btn-sm btn-outline-primary">Predeterminada</button>
                            </form>
                        }
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@item.Id">Editar</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id">Eliminar</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="mt-4">
        <div class="alert alert-warning" role="alert">
            Aún no tienes direcciones de envío registradas.
        </div>
    </div>
}
