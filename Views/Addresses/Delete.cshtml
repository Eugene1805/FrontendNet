@model Address
@{
    ViewData["Title"] = "Mis direcciones";
    ViewData["SubTitle"] = "Eliminar";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a class="text-decoration-none" asp-action="Index">Listado</a></li>
        <li class="breadcrumb-item active" aria-current="page">@ViewData["SubTitle"]</li>
    </ol>
</nav>

<h2 class="text-center mb-3">@ViewData["Title"] <small class="text-muted fs-5">@ViewData["SubTitle"]</small></h2>

<p class="text-danger">¿Está seguro de que desea eliminar esta dirección de envío?</p>
@if (ViewData["ErrorMessage"] is string errorMessage)
{
    <p class="text-danger">@errorMessage</p>
}

<div class="card mt-3">
    <div class="card-body small">
        <p class="mb-1 fw-semibold">@Model.RecipientName</p>
        <p class="mb-1">
            @Model.Street @Model.ExteriorNumber
            @if (!string.IsNullOrWhiteSpace(Model.InteriorNumber))
            {
                <text> Int. @Model.InteriorNumber</text>
            }
        </p>
        <p class="mb-1">@Model.Neighborhood</p>
        <p class="mb-0 text-muted">@Model.City, @Model.State, C.P. @Model.PostalCode, @Model.Country</p>
    </div>
</div>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <div class="text-center mt-3">
        <button id="submitButton" type="submit" class="btn btn-sm btn-danger">Eliminar</button>
        <a class="btn btn-sm btn-outline-secondary" asp-action="Index">Cancelar</a>
    </div>
</form>
