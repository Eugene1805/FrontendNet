{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ApiBaseUrl": "https://localhost:7099",
  "ProductImages": {
    "MaxBytes": 2097152,
    "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".webp" ],
    "AllowedContentTypes": [ "image/jpeg", "image/png", "image/webp" ],
    "AllowedHosts": [ "https://res.cloudinary.com" ]
  },
  "Pagination": {
    "PageSize": 20
  },
  "Security": {
    "RequireHttps": true,
    "ForwardedForHeaderName": "X-Forwarded-For",
    "TrustedProxyCidrs": []
  },
  "Cloudflare": {
    "TurnstileSiteKey": "",
    "TurnstileSecretKey": ""
  }
}
