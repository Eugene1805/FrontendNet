<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- The test project lives in a subfolder and must not be compiled as part of the web application. -->
  <ItemGroup>
    <Compile Remove="FrontendNet.Tests/**" />
    <Content Remove="FrontendNet.Tests/**" />
    <EmbeddedResource Remove="FrontendNet.Tests/**" />
    <None Remove="FrontendNet.Tests/**" />
  </ItemGroup>

</Project>
